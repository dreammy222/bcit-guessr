# ============================================================================
# campus-guessr environment variables
# Copy to .env.local for local dev; set the same vars in Vercel for production.
# Validate your setup with:  node scripts/setup-check.mjs [--connect]
# ============================================================================

# ---------------------------------------------------------------------------
# Clerk (authentication) — create an application at https://dashboard.clerk.com
# ---------------------------------------------------------------------------
# Client key (safe to expose; pk_test_... for dev instance, pk_live_... for prod)
VITE_CLERK_PUBLISHABLE_KEY=
# Token issuer for verifying JWTs server-side, e.g. https://clerk.yourschoolguessr.com
# (or your dev instance: https://your-app-name.clerk.accounts.dev)
CLERK_ISSUER=
# Signing secret for the Clerk user webhook (Dashboard → Webhooks → your endpoint)
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional alternates (only needed if you prefer them over CLERK_ISSUER):
# CLERK_JWKS_URL=
# CLERK_FAPI= / CLERK_FRONTEND_API=

# ---------------------------------------------------------------------------
# Locations backend — where the canonical photo coordinates live.
#   dynamo   (default) AWS DynamoDB
#   supabase Postgres, reusing the party-mode project. Run
#            supabase/locations_schema.sql, then seedLocations.mjs. No AWS
#            credentials needed for locations at all.
# ---------------------------------------------------------------------------
# LOCATIONS_BACKEND=dynamo
# LOCATIONS_TABLE=locations     # supabase backend only

# ---------------------------------------------------------------------------
# AWS — DynamoDB (locations, when LOCATIONS_BACKEND=dynamo) + S3 (photos)
# ---------------------------------------------------------------------------
AWS_REGION=us-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary credentials
# DynamoDB table with partition key "id" (String). Falls back to
# backendDefaults.dynamoTableName in src/config/school.ts if unset.
DYNAMO_TABLE_NAME=
# Public base URL of the S3 bucket (or CDN) that hosts the photos.
# Falls back to backendDefaults.photoBaseUrl in school.ts if unset.
PHOTO_BASE_URL=
# PHOTO_CDN_BASE_URL=           # alternate name; PHOTO_BASE_URL wins
# Same URL for the client bundle (Vite):
VITE_PHOTO_BASE_URL=

# ---------------------------------------------------------------------------
# Vercel KV (leaderboard, daily challenge, rate limiting)
# Auto-populated when you attach a KV store to the Vercel project.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Namespace for KV keys (leaderboard etc.). Falls back to
# backendDefaults.kvKeyPrefix in school.ts if unset.
# KV_KEY_PREFIX=
# RATE_LIMIT_BACKEND=kv         # 'kv' (default when KV configured) or 'memory'

# ---------------------------------------------------------------------------
# Supabase (party mode realtime) — create a project, then run
# supabase/party_mode_schema.sql + the migration files against it.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Anon key fallbacks used by some endpoints if the service key is absent:
# SUPABASE_ANON_KEY= / VITE_SUPABASE_URL= / VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Site / deployment
# ---------------------------------------------------------------------------
# Protects the daily cron endpoint (set any long random string; Vercel sends it)
CRON_SECRET=
# Sitemap generation prefers these over the school config siteUrl:
# SITEMAP_SITE_URL= / SITE_URL= / VITE_SITE_URL= / APP_URL=

# ---------------------------------------------------------------------------
# Game
# ---------------------------------------------------------------------------
# Promo codes redeemable in the avatar shop. Format:
#   CODE:coins=5000              (grants coins)
#   CODE:cosmetics=id1+id2       (grants cosmetics)
#   CODE:coins=1000;cosmetics=id (both) — separate multiple codes with commas
# PROMO_CODES=WELCOME:coins=5000
# Which locations JSON scripts/seedLocations.mjs reads
# LOCATIONS_FILE=locations.ubc.json
